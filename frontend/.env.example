# Public Supabase project config for the catalog storefront.
# Both vars are intentionally NEXT_PUBLIC_* -- safe to expose to the
# browser bundle. Never add a service_role key to this file or to any
# frontend env file: the frontend only ever reads catalog_* views under
# the anon key (see openspec/changes/public-catalog-screens/design.md).

# Local: http://127.0.0.1:54321 (supabase start)
# Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local: the Supabase CLI's default demo anon key (same for every local
# project unless supabase/config.toml overrides the JWT secret).
# Hosted: the project's anon/public API key from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend origin for the admin proxy (server-only; NEVER add NEXT_PUBLIC_ prefix)
BACKEND_URL=http://127.0.0.1:8000
