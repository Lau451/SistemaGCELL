# Local Supabase Postgres (started via `npx supabase start`).
# Superuser DSN -- bypasses RLS by design; authorization lands with the
# admin route layer in a later change. See design.md "Migration / Rollout".
DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Admin panel JWT verification (see design.md "Decision: PyJWT, not
# python-jose" -- corrected to ES256/JWKS). Local Supabase Auth signs
# tokens with an asymmetric per-project key pair, so verification fetches
# the PUBLIC key from the JWKS endpoint below -- there is no shared
# JWT_SECRET to protect here.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
