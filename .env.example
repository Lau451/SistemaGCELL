# Backend-only. Never commit real values; see .gitignore (.env, .env.* are
# ignored except this file). config.py's `os.environ.get(...)` reads these
# directly -- no dotenv dependency, this file documents the names only.

DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Gemini-assisted product copy generation (content-ai-domains). Unset ->
# the two generate endpoints return 503; the rest of the app is
# unaffected. Optional GEMINI_MODEL overrides the default
# gemini-2.5-flash pin without a deploy (design.md DD4).
GEMINI_API_KEY=
GEMINI_MODEL=
